<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+) backup + device-to-device transfer rules: exclude every
     domain. Nothing the app stores locally (secure-storage ciphertext,
     SharedPreferences drafts, caches) leaves the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </device-transfer>
</data-extraction-rules>
