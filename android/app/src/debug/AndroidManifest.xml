<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Lab cleartext (API_BASE=http://10.0.2.2:3088) is NOT enabled here via
         usesCleartextTraffic: the debug source set instead overrides
         res/xml/network_security_config.xml to permit cleartext for 127.0.0.1,
         localhost and 10.0.2.2 ONLY. Not merged into release builds. -->
</manifest>
